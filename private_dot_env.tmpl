# ~/.env — generated by chezmoi + 1Password
# This file is PRIVATE (chmod 600). Never commit raw secrets.
# Edit the SOURCE at: ~/dotfiles/private_dot_env.tmpl
#
# HOW TO ADD A NEW SECRET:
#   1. Save the secret in 1Password under vault "Personal" or "Work"
#   2. Add a line below using: {{ onepasswordRead "op://VaultName/ItemName/FieldName" }}
#   3. Run: chezmoi apply

# ── GitHub ───────────────────────────────────────────────────────────────────
# Create item in 1Password: vault=Personal, item="GitHub PAT", field="token"
# export GITHUB_TOKEN={{ onepasswordRead "op://Personal/GitHub PAT/token" }}

# ── Anthropic / Claude API ───────────────────────────────────────────────────
# export ANTHROPIC_API_KEY={{ onepasswordRead "op://Personal/Anthropic API/credential" }}

# ── AWS (if applicable) ──────────────────────────────────────────────────────
# export AWS_ACCESS_KEY_ID={{ onepasswordRead "op://Work/AWS/access_key_id" }}
# export AWS_SECRET_ACCESS_KEY={{ onepasswordRead "op://Work/AWS/secret_access_key" }}

# ── Add your own secrets below ───────────────────────────────────────────────
# Pattern: export MY_KEY={{ onepasswordRead "op://VaultName/ItemName/FieldName" }}
