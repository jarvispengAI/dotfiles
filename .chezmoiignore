# Python compiled bytecode — never track these
**/__pycache__
**/*.pyc

# Files to ignore on specific platforms
{{ if ne .chezmoi.os "darwin" }}
# Mac-only files — skip on Windows/Linux
dot_zshrc.tmpl
{{ end }}

{{ if ne .chezmoi.os "windows" }}
# Windows-only files — skip on Mac/Linux
dot_config/powershell
{{ end }}

{{ if eq .chezmoi.os "windows" }}
# Unix shell scripts — skip on Windows (use _windows.cmd variants instead)
run_once_after_setup-claude.sh
{{ end }}

# Helper scripts called by run_once scripts (not deployed to home dir)
setup-claude.ps1

# Claude Code modifies this at runtime (plugins, permissions.allow, etc.)
# Manage manually: `chezmoi apply --force ~/.claude/settings.json` on new machine
.claude/settings.json
