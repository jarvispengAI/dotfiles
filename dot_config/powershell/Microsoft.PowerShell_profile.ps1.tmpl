# PowerShell Profile — managed by chezmoi

# ── Secrets (loaded from ~/.env via chezmoi) ────────────────────────────────
$envFile = Join-Path $HOME ".env"
if (Test-Path $envFile) {
    Get-Content $envFile | ForEach-Object {
        if ($_ -match '^\s*([^#][^=]+)=(.*)$') {
            [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process')
        }
    }
}

# ── Aliases ──────────────────────────────────────────────────────────────────
function gs  { git status }
function gl  { git log --oneline --graph --decorate --all }
function ll  { Get-ChildItem -Force @args }
function gp  { git push @args }
function gc  { git commit @args }

function cz  { chezmoi @args }
function czd { chezmoi diff }
function cza { chezmoi apply }

# 推送本機修改到 GitHub
function czpush {
    chezmoi re-add 2>$null
    $src = chezmoi source-path
    Push-Location $src
    git add -A
    git commit -m "sync: $(Get-Date -Format 'yyyy-MM-dd')"
    git push
    Pop-Location
}

# 從 GitHub 拉取最新並套用
function czpull {
    $status = (bw status | ConvertFrom-Json).status
    if ($status -ne 'unlocked') {
        $token = bw unlock --raw
        $env:BW_SESSION = $token
        [System.Environment]::SetEnvironmentVariable('BW_SESSION', $token, 'User')
    }
    chezmoi update
}

