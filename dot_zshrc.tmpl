# ── Homebrew ────────────────────────────────────────────────────────────────
if [[ -f /opt/homebrew/bin/brew ]]; then       # Apple Silicon Mac
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then        # Intel Mac
    eval "$(/usr/local/bin/brew shellenv)"
fi

# ── Path ────────────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# ── Secrets (loaded from 1Password via chezmoi) ────────────────────────────
# These are written by chezmoi from private_dot_env.tmpl → ~/.env
# Do NOT put raw secrets in this file.
[[ -f "$HOME/.env" ]] && source "$HOME/.env"

# ── Aliases ─────────────────────────────────────────────────────────────────
alias ll="ls -lah"
alias gs="git status"
alias gl="git lg"
alias gc="git commit"
alias gp="git push"
alias code="open -a 'Visual Studio Code'"

# ── chezmoi shortcut ────────────────────────────────────────────────────────
alias cz="chezmoi"
alias czd="chezmoi diff"
alias cza="chezmoi apply"
alias cze="chezmoi edit"
alias czcd="cd $(chezmoi source-path)"

# 推送本機修改到 GitHub
czpush() {
    chezmoi re-add 2>/dev/null
    cd "$(chezmoi source-path)"
    git add -A
    git commit -m "sync: $(date +%Y-%m-%d)" 2>/dev/null || echo "nothing to commit"
    git push
    cd -
}

# 從 GitHub 拉取最新並套用
czpull() {
    export BW_SESSION=$(bw unlock --raw)
    chezmoi update
}

# ── Node / nvm ──────────────────────────────────────────────────────────────
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

