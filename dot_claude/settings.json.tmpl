  "hasCompletedOnboarding": true,
  "mcpServers": {
    "linkedin": {
      "args": [
        "linkedin-scraper-mcp@latest"
      ],
      "command": "uvx",
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "workspace-mcp": {
      "args": [
        "workspace-mcp",
        "--single-user"
      ],
      "command": "uvx",
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "{{ env "GOOGLE_OAUTH_CLIENT_ID" }}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "{{ env "GOOGLE_OAUTH_CLIENT_SECRET" }}",
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      }
    }
  }
}
